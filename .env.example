# Copy this file to .env. Keep local credentials out of version control.
EXPO_PUBLIC_AUTH_ENABLED=true
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_PORT=8080
# Optional override only if automatic LAN adapter selection picks the wrong network.
# MOBILE_LAN_HOST=192.168.1.10
# Web OAuth client ID (not the Android one) used to obtain the Google ID token; must also be listed in the backend GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Learner website, opened for learning-path links the app does not have yet ("Luyện lỗi này", course history). Leave empty to hide those links.
EXPO_PUBLIC_WEB_APP_URL=
# Set to true for an App Store build to hide activation-key entry on iOS (store rules on unlocking digital content).
EXPO_PUBLIC_HIDE_IOS_KEY_ACTIVATION=false
