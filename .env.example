# Must log in before Hôm nay, learn, and flashcards.
# Set to false only for local UI work without the gateway.
EXPO_PUBLIC_AUTH_ENABLED=true

# Gateway. Leave unset on a phone: Expo Go uses the Metro host (the PC's LAN IP) on port 8080.
# Web stays on localhost:8080. Android emulator without Metro host uses 10.0.2.2:8080.
# The Compose gateway is published on 127.0.0.1 only, so a phone also needs
# `node scripts/lan-gateway-proxy.mjs` on the PC.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Path and session use the local mock unless this is false.
# EXPO_PUBLIC_USE_MOCK_LEARNING=true
