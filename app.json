{
  "expo": {
    "name": "IELTSPath",
    "slug": "ielts-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ieltsmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doan.ieltsmobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f97316",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.doan.ieltsmobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mascot.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "backgroundColor": "#ff7624"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép IELTSPath truy cập ảnh để bạn chia sẻ trong cộng đồng.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
